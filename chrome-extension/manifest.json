{
  "manifest_version": 3,
  "name": "QAtalyst - AI Test Case Generator",
  "version": "10.1.0",
  "description": "AI-powered Jira assistant for intelligent test case generation.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://*.atlassian.net/*",
    "https://*.jira.com/*",
    "https://*.confluence.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.figma.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://figma-alpha-api.s3.us-west-2.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/browse/*",
        "https://*.jira.com/browse/*"
      ],
      "js": ["config.js", "security.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*.atlassian.net/*", "https://*.jira.com/*"]
    }
  ]
}
