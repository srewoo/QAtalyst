{
  "manifest_version": 3,
  "name": "QAtalyst - AI Test Case Generator",
  "version": "12.5.2",
  "description": "AI-powered Jira assistant with intelligent web app crawling and context-aware test generation.",
  "permissions": [
    "storage",
    "identity",
    "webRequest",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "declarativeNetRequest",
    "downloads"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://*.jira.com/*",
    "https://*.confluence.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.figma.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://figma-alpha-api.s3.us-west-2.amazonaws.com/*",
    "https://media-api.atlassian.com/*",
    "https://*.media.atlassian.com/*",
    "https://api.media.atlassian.com/*",
    "https://*.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/browse/*",
        "https://*.jira.com/browse/*"
      ],
      "js": ["graph-filter.js", "config.js", "logger.js", "security.js", "duplicate-detector.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "config.json"],
      "matches": ["https://*.atlassian.net/*", "https://*.jira.com/*", "<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
